/**
 * Relay Pulse - Main Application Configuration
 * Resources are auto-created during deployment - no manual configuration needed
 * 
 * Note: preview_id/preview_database_id are for local development only.
 * Production IDs are auto-generated by Cloudflare during deployment.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "relay-pulse",
	"main": "worker/index.ts",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"*/5 * * * *",
			"0 2 * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "RELAY_PULSE_KV",
			"preview_id": "4c9a1f4c7ab278f5bfe1e4da22e073ef"
		}
	],
	"r2_buckets": [
		{
			"binding": "RELAY_PULSE_BUCKET",
			"bucket_name": "relay-pulse-assets"
		}
	],
	"d1_databases": [
		{
			"binding": "RELAY_PULSE_DB",
			"database_name": "relay-pulse-db",
			"preview_database_id": "901b4b95-d9ae-4f58-a331-f6b45fa21506",
			"migrations_dir": "./migrations"
		}
	]
}