/**
 * Relay Pulse - Main Application Configuration
 * Resources are auto-created during deployment - no manual configuration needed
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "relay-pulse",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "RELAY_PULSE_KV",
			"preview_id": "relay-pulse-kv-preview"
		}
	],
	"r2_buckets": [
		{
			"binding": "RELAY_PULSE_BUCKET",
			"bucket_name": "relay-pulse-assets"
		}
	],
	"d1_databases": [
		{
			"binding": "RELAY_PULSE_DB",
			"database_name": "relay-pulse-db",
			"migrations_dir": "./migrations"
		}
	]
}
