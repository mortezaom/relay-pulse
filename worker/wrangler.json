{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay-pulse-worker",
  "main": "src/index.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "minify": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "kv_namespaces": [
    {
      "binding": "RELAY_PULSE_KV",
      "id": "f574d593c06d42a59565500813564023"
    }
  ],
  "d1_databases": [
    {
      "binding": "RELAY_PULSE_DB",
      "database_name": "relay-pulse-db",
      "database_id": "e921c1e7-88fc-4d90-a6fc-39fa8a92f6b1",
      "migrations_dir": "migrations"
    }
  ]
}
