{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "relay-pulse-monitor",
	"main": "src/workers/scheduler.ts",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": ["nodejs_compat"],
	
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	
	"kv_namespaces": [
		{
			"binding": "RELAY_PULSE_KV",
			"id": "c325e07132e520c6a7a908038f3d94c5",
			"preview_id": "4c9a1f4c7ab278f5bfe1e4da22e073ef"
		}
	],
	"r2_buckets": [
		{
			"binding": "RELAY_PULSE_BUCKET",
			"bucket_name": "relay-pulse-assets"
		}
	],
	"d1_databases": [
		{
			"binding": "RELAY_PULSE_DB",
			"database_name": "relay-pulse-db",
			"database_id": "901b4b95-d9ae-4f58-a331-f6b45fa21506"
		}
	]
}