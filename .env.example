# Relay Pulse - Minimal Environment Configuration
# Only essential secrets needed for deployment

# Required: Cloudflare API credentials for deployment
# Get these from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Required: Basic auth secrets (auto-generated during setup if not provided)
RELAY_AUTH_SECRET=your_secure_random_string_here
RELAY_JWT_SECRET=your_secure_random_string_here

# Optional: Override default app name
APP_NAME="Relay Pulse"

# Note: All other settings are managed through the web dashboard
# including monitoring intervals, notification settings, etc.