# Relay Pulse - Environment Configuration
# Copy this to .env.local for local development

# ============================================
# Cloudflare Deployment (Required for CI/Deployment)
# ============================================
# Get these from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# ============================================
# Authentication & Security (Required)
# ============================================
# Email for initial admin setup
# This is checked during the setup endpoint
RELAY_AUTH_EMAIL=admin@example.com

# Secret token for initial admin setup (one-time use)
# Must be provided in the POST request body during setup
# Generate with: openssl rand -base64 32
RELAY_AUTH_SECRET=your_setup_secret_here

# JWT secret for session management
# If not set, will be auto-generated and stored in KV
# For production, set explicitly via: wrangler secret put RELAY_JWT_SECRET
# Generate with: openssl rand -base64 32
RELAY_JWT_SECRET=your_jwt_secret_here

# ============================================
# Important Notes
# ============================================
# 1. For local dev: Just run `pnpm dev` - all Cloudflare bindings are mocked
# 2. For deployment:
#    - Set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID for setup script
#    - Run: npm run setup:resources (creates D1, KV, R2 automatically)
#    - Set RELAY_JWT_SECRET as a secret: wrangler secret put RELAY_JWT_SECRET
# 3. All monitoring settings are managed via dashboard (stored in Cloudflare KV)
# 4. All notification channels are stored in Cloudflare KV per service
# 5. Never commit .env.local to git

# ============================================
# GitHub Actions / Repository Secrets
# ============================================
# Add these as repository secrets (Settings → Secrets and variables → Actions):
# - CLOUDFLARE_API_TOKEN (required for deployment)
# - CLOUDFLARE_ACCOUNT_ID (required for deployment)
# - RELAY_JWT_SECRET (recommended for production, auto-generated if omitted)

# ============================================
# Cloudflare Bindings (auto-configured)
# ============================================
# These are Cloudflare Worker bindings configured in wrangler.json
# and generated automatically by the setup script:
# - RELAY_PULSE_KV: Cloudflare KV namespace for app data
# - RELAY_PULSE_DB: Cloudflare D1 database for services/incidents
# - RELAY_PULSE_BUCKET: Cloudflare R2 bucket for file uploads
# - ASSETS: Cloudflare Assets binding for static files
