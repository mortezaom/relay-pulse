# Relay Pulse - Environment Configuration
# Copy this to .env.local for local development

# ============================================
# Cloudflare API (Required for Deployment)
# ============================================
# Get these from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# ============================================
# Authentication Secrets
# ============================================
# JWT secret for session management
# Generate with: openssl rand -base64 32
RELAY_JWT_SECRET=your_secure_random_string_here

# Initial admin password (used during first setup)
# Generate with: openssl rand -base64 24
RELAY_AUTH_SECRET=your_secure_random_string_here

# ============================================
# Optional Configuration
# ============================================
# Override default app name
APP_NAME="Relay Pulse"

# ============================================
# Important Notes
# ============================================
# 1. For local dev: Just run `pnpm dev` - bindings are mocked
# 2. For deployment: Set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID
# 3. All monitoring settings are managed via dashboard (stored in KV)
# 4. Never commit .env.local to git

# ============================================
# GitHub Actions Setup
# ============================================
# Add these as repository secrets (Settings → Secrets):
# - CLOUDFLARE_API_TOKEN
# - CLOUDFLARE_ACCOUNT_ID
# - RELAY_JWT_SECRET (optional - auto-generated if omitted)
